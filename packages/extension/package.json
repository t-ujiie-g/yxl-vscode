{
  "name": "yxl-vscode",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The VS Code preview: the panel beside the text, the filesystem, and the yxl CLI.",
  "type": "module",
  "displayName": "yxl preview",
  "publisher": "t-ujiie-g",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.cjs",
  "exports": {
    "./write": "./src/write.ts"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "yxl.showPreview",
        "title": "Open the Grid Beside the Spec",
        "category": "yxl",
        "icon": "$(table)"
      },
      {
        "command": "yxl.showSource",
        "title": "Go to the Spec Behind the Grid",
        "category": "yxl",
        "icon": "$(go-to-file)"
      },
      {
        "command": "yxl.check",
        "title": "Check the Spec",
        "category": "yxl",
        "icon": "$(check)"
      },
      {
        "command": "yxl.build",
        "title": "Build the Workbook",
        "category": "yxl",
        "icon": "$(package)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yxl.showPreview",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/",
          "group": "navigation@1"
        },
        {
          "command": "yxl.showSource",
          "when": "activeWebviewPanelId == 'yxl.preview'",
          "group": "navigation@1"
        },
        {
          "command": "yxl.build",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'",
          "group": "navigation@2"
        },
        {
          "command": "yxl.check",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "yxl.check",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'"
        },
        {
          "command": "yxl.build",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'"
        },
        {
          "command": "yxl.showPreview",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/"
        },
        {
          "command": "yxl.showSource",
          "when": "activeWebviewPanelId == 'yxl.preview'"
        }
      ]
    },
    "configuration": {
      "title": "yxl",
      "properties": {
        "yxl.path": {
          "type": "string",
          "default": "yxl",
          "markdownDescription": "The `yxl` compiler this extension runs. A bare name is looked up on `PATH`; an absolute path is used as given."
        }
      }
    },
    "keybindings": [
      {
        "command": "yxl.keepKey",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeWebviewPanelId == 'yxl.preview'"
      },
      {
        "command": "yxl.keepKey",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeWebviewPanelId == 'yxl.preview'"
      },
      {
        "command": "yxl.keepKey",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "activeWebviewPanelId == 'yxl.preview'"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@yxl-vscode/compile": "workspace:*",
    "@yxl-vscode/cst": "workspace:*",
    "@yxl-vscode/diag": "workspace:*",
    "@yxl-vscode/evaluate": "workspace:*",
    "@yxl-vscode/intent": "workspace:*",
    "@yxl-vscode/loader": "workspace:*",
    "@yxl-vscode/patch": "workspace:*",
    "@yxl-vscode/spec": "workspace:*",
    "@yxl-vscode/units": "workspace:*",
    "@yxl-vscode/verify": "workspace:*",
    "@yxl-vscode/webview": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "~1.104.0",
    "esbuild": "^0.28.2"
  }
}
