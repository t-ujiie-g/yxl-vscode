{
  "name": "yxl-vscode",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "%extension.description%",
  "type": "module",
  "displayName": "yxl \u2014 the grid beside the spec",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-ujiie-g/yxl-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/t-ujiie-g/yxl-vscode/issues"
  },
  "homepage": "https://github.com/t-ujiie-g/yxl-vscode#readme",
  "keywords": [
    "yxl",
    "xlsx",
    "excel",
    "spreadsheet",
    "yaml"
  ],
  "publisher": "t-ujiie-g",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "exports": {
    "./text": "./src/text.ts",
    "./words": "./src/words.ts",
    "./write": "./src/write.ts"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "yxl.newSpec",
        "title": "%command.newSpec%",
        "category": "yxl",
        "icon": "$(new-file)"
      },
      {
        "command": "yxl.showPreview",
        "title": "%command.showPreview%",
        "category": "yxl",
        "icon": "$(table)"
      },
      {
        "command": "yxl.showSource",
        "title": "%command.showSource%",
        "category": "yxl",
        "icon": "$(go-to-file)"
      },
      {
        "command": "yxl.check",
        "title": "%command.check%",
        "category": "yxl",
        "icon": "$(check)"
      },
      {
        "command": "yxl.build",
        "title": "%command.build%",
        "category": "yxl",
        "icon": "$(package)"
      },
      {
        "command": "yxl.tidy",
        "title": "%command.tidy%",
        "category": "yxl",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yxl.newSpec"
        },
        {
          "command": "yxl.check",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'"
        },
        {
          "command": "yxl.build",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'"
        },
        {
          "command": "yxl.showPreview",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/"
        },
        {
          "command": "yxl.showSource",
          "when": "activeWebviewPanelId == 'yxl.preview'"
        },
        {
          "command": "yxl.tidy",
          "when": "resourceFilename =~ /\\\\.yxl\\\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'"
        }
      ],
      "editor/title": [
        {
          "command": "yxl.showPreview",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/",
          "group": "navigation@1"
        },
        {
          "command": "yxl.showSource",
          "when": "activeWebviewPanelId == 'yxl.preview'",
          "group": "navigation@1"
        },
        {
          "command": "yxl.build",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'",
          "group": "navigation@2"
        },
        {
          "command": "yxl.check",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/ || activeWebviewPanelId == 'yxl.preview'",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "yxl.newSpec",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "file/newFile": [
        {
          "command": "yxl.newSpec"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": [
          "*.yxl.yaml",
          "*.yxl.yml"
        ],
        "url": "./schema/yxl.schema.json"
      }
    ],
    "configuration": {
      "title": "yxl",
      "properties": {
        "yxl.path": {
          "type": "string",
          "default": "yxl",
          "markdownDescription": "%configuration.path%"
        }
      }
    },
    "keybindings": [
      {
        "command": "yxl.keepKey",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeWebviewPanelId == 'yxl.preview'"
      },
      {
        "command": "yxl.keepKey",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeWebviewPanelId == 'yxl.preview'"
      },
      {
        "command": "yxl.keepKey",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "activeWebviewPanelId == 'yxl.preview'"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && pnpm dlx @vscode/vsce@3.9.2 package --no-dependencies"
  },
  "dependencies": {
    "@yxl-vscode/compile": "workspace:*",
    "@yxl-vscode/cst": "workspace:*",
    "@yxl-vscode/diag": "workspace:*",
    "@yxl-vscode/evaluate": "workspace:*",
    "@yxl-vscode/intent": "workspace:*",
    "@yxl-vscode/loader": "workspace:*",
    "@yxl-vscode/patch": "workspace:*",
    "@yxl-vscode/refactor": "workspace:*",
    "@yxl-vscode/spec": "workspace:*",
    "@yxl-vscode/units": "workspace:*",
    "@yxl-vscode/verify": "workspace:*",
    "@yxl-vscode/webview": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "~1.104.0",
    "esbuild": "^0.28.2"
  }
}
