{
  "name": "yxl-vscode",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The VS Code preview: the panel beside the text, the filesystem, and the yxl CLI.",
  "type": "module",
  "displayName": "yxl preview",
  "publisher": "t-ujiie-g",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "yxl.showPreview",
        "title": "Open Preview to the Side",
        "category": "yxl"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yxl.showPreview",
          "when": "resourceFilename =~ /\\.yxl\\.ya?ml$/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@yxl-vscode/compile": "workspace:*",
    "@yxl-vscode/cst": "workspace:*",
    "@yxl-vscode/diag": "workspace:*",
    "@yxl-vscode/loader": "workspace:*",
    "@yxl-vscode/spec": "workspace:*",
    "@yxl-vscode/units": "workspace:*",
    "@yxl-vscode/webview": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.28.2"
  }
}
